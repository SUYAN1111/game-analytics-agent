{
  "config_version": "m03_v1",
  "contract_version": "m03_raw_tables_v1",
  "metric": {"id": "M03", "main_window_hours": 72, "planned_sensitivity_window_hours": [48, 96],
             "unit": ["user_id", "story_id"], "window": "[t0,t0+duration)",
             "t0": "max(region_open_at,prereq_met_at)", "numerator": "Q5", "denominator": ["Q4", "Q5"],
             "zero_denominator_rate": null, "expected_story_minutes": 45},
  "regions": [{"region_id": "R1", "utc_offset_hours": 0}, {"region_id": "R2", "utc_offset_hours": 8}, {"region_id": "R3", "utc_offset_hours": -5}],
  "languages": ["L1", "L2"],
  "clients": ["PC", "Mobile"],
  "allowed_groups": ["version_id", "region_id", "language", "client", "new_player"],
  "sources": [
    {"source_id": "src01", "region_id": "R1", "event_kind": "story_start"},
    {"source_id": "src02", "region_id": "R1", "event_kind": "session"},
    {"source_id": "src03", "region_id": "R2", "event_kind": "story_start"},
    {"source_id": "src04", "region_id": "R2", "event_kind": "session"},
    {"source_id": "src05", "region_id": "R3", "event_kind": "story_start"},
    {"source_id": "src06", "region_id": "R3", "event_kind": "session"}
  ],
  "m03_source_bindings": {"R1": ["src01"], "R2": ["src03"], "R3": ["src05"]},
  "targets": {"fields": ["user_id", "story_id", "region_open_at", "required_source_ids"],
              "inclusion": "registered_at<=own_region_version_open", "derive_from": ["players", "player_attributes", "story_calendar", "source_catalog"],
              "from_start_events": false, "external_coverage_flag": false},
  "time_split": {"train": ["V1", "V2", "V3"], "selection": ["V4"], "test": ["V5", "V6"]},
  "history_boundary": {"event_time": "<t0", "available_at": "<=t0", "session_end_at": "<t0",
                       "new_player_age_hours": 168, "new_player_comparison": "<"},
  "planned_features": ["recent_valid_sessions", "recent_active_days", "observed_days", "time_since_last_valid_session",
                       "historical_session_minutes", "historical_session_45min_share", "previous_complete_story_windows",
                       "previous_story_starts", "account_age", "new_player", "time_since_region_open",
                       "expected_story_minutes", "region_id", "language", "client"],
  "forbidden_features": ["user_id", "story_id", "master_seed", "active_tendency", "time_tendency", "fault_label",
                         "future_session_minutes", "future_start", "future_completion", "coverage_complete", "final_label", "q_state"],
  "field_uses": {"user_id": "join_only", "story_id": "join_only", "upload_id": "upload_audit",
                 "session_id": "logical_event_and_join", "event_id": "logical_event_and_deduplication",
                 "record_id": "evidence_audit", "source_id": "binding_and_evidence",
                 "available_at": "snapshot_visibility", "coverage_complete": "derived_observation_audit_only"},
  "access_policy": {"agent_reads": ["authorized_observed_data", "business_configs"],
                    "agent_excludes": ["simulation/configs", "generator_internals", "evaluation_truth", "private_eval"],
                    "private_output_template": "private_eval/generated/<run_id>/",
                    "observed_output_template": "data/generated/<dataset_id>/observed/",
                    "runtime_enforcement": "pending", "gitignore_is_access_control": false}
}
